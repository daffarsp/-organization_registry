{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],

    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "CONFIG_CACHE": "/tmp/config.php",
        "ROUTES_CACHE": "/tmp/routes.php",
        "SERVICES_CACHE": "/tmp/services.php",
        "PACKAGES_CACHE": "/tmp/packages.php",
        "VIEW_COMPILED_PATH": "/tmp/views"
    }
}